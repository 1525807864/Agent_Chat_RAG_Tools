# =============================================================================
# Nexora 本地 / 通用环境变量模板
# 复制为 `.env` 后填写真实值。切勿提交 `.env`。
# 系统环境变量若已设置，优先级高于本文件。
# =============================================================================

# --- LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
TAVILY_API_KEY=
# Cursor Agent SDK（https://cursor.com/dashboard/integrations）。密钥以 crsr_ 开头。
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
SEARCH_SSL_VERIFY=true
ENABLE_EXECUTE_PYTHON=false
# SEARCH_RESULT_LIMIT=5
# SEARCH_TIMEOUT=10

# Embedding（须与 Key 同一厂商；智谱示例如下）
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3

# --- 会话存储：本地 sqlite；Compose/生产用 redis ---
MEMORY_BACKEND=sqlite
# REDIS_URL=redis://127.0.0.1:6379/0
# MEMORY_BACKEND=redis
# MEMDIR_PATH=data/memdir
# MEMORY_SOLIP_ENABLED=true
# MEMORY_SOLIP_TOP_K=3
# MEMORY_RELEVANCE_TOP_K=6
# MEMORY_V2_ENABLED=true
# MEMORY_QUERY_REWRITE_ENABLED=true
# MEMORY_FACT_EXTRACT_ENABLED=true

# --- 鉴权 ---
# 本地 Electron / 裸跑 API：可 AUTH_ENABLED=false；联调鉴权改 true
AUTH_ENABLED=false
STRICT_PRODUCTION=false
AUTH_DEBUG_ENABLED=false
OPENAPI_ENABLED=true
JWT_SECRET=change-me-to-long-random-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEFAULT_TENANT_ID=default
AUTH_USERS_DB_PATH=data/users.db
AUTH_BOOTSTRAP_RESET_ADMIN=false
ALLOW_REGISTER=true
# 生产默认 mysql；本地无 MySQL 时改为 sqlite
AUTH_BACKEND=mysql
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- MySQL（AUTH_BACKEND=mysql 时必填；Compose 内 MYSQL_HOST 必须是服务名 mysql）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=langchain_demo
MYSQL_PASSWORD=
MYSQL_DATABASE=langchain_demo
MYSQL_ROOT_PASSWORD=

# --- 限流 ---
RATE_LIMIT_BACKEND=memory
LOGIN_RATE_LIMIT=5
RATE_LIMIT_REQUESTS=60
TRUST_PROXY=false

# --- HTTP ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=*
DEBUG=true
LOG_LEVEL=INFO
OTEL_ENABLED=false

# --- 桌面安装包下载 ---
DESKTOP_DOWNLOAD_ENABLED=true
DESKTOP_RELEASE_DIR=downloads
DESKTOP_RELEASE_NAME=Nexora-Setup.exe

# --- RAG / 混合检索 ---
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_FETCH_K=10
HYBRID_RRF_K=60
HYBRID_USE_ROUTER=true
# GRAPH_EXTRACT_ON_BUILD=false
# GRAPH_EXTRACT_MAX_DOCS=10

# --- E2E / MCP ---
E2E_ALLOW_LOCAL=false
E2E_TIMEOUT_SECONDS=120
E2E_USER=
E2E_PASSWORD=
E2E_MCP_COMMAND=npx
E2E_MCP_ARGS=-y,@playwright/mcp@latest,--headless
# MCP_SERVERS_JSON=[{"name":"playwright","transport":"stdio","command":"npx","args":["-y","@playwright/mcp@latest","--headless"]}]
MCP_SERVERS_JSON=
ACTIVE_TOOL_DISCOVERY=false
ACTIVE_TOOL_TOP_K=5
ACTIVE_TOOL_BASE=calculator,web_search

# --- LangSmith（密钥只放本机 .env，不要提交）---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexora-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# 平台沙箱（docker run 短生命周期容器；镜像需先 build）
#   docker build -t nexora-sandbox:latest -f docker/sandbox/Dockerfile docker/sandbox
# =============================================================================
SANDBOX_ENABLED=false
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=nexora-sandbox:latest
# 本地相对路径即可；Compose + docker.sock 时必须改成宿主机绝对路径
# （见 .env.production.example 的 SANDBOX_WORKSPACE_HOST）
SANDBOX_WORKSPACE_HOST=data/sandbox
SANDBOX_MODE=workspace-write
SANDBOX_NETWORK=none
SANDBOX_NETWORK_MODE=deny
SANDBOX_EGRESS_ALLOWLIST=
SANDBOX_EGRESS_PROXY_PORT=18080
SANDBOX_APPROVAL=on-risky
SANDBOX_MAX_SESSIONS_PER_TENANT=3
SANDBOX_ALLOW_SHELL_STRING=false
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_IDLE_SEC=1800
SANDBOX_EXEC_TIMEOUT_SEC=60
SANDBOX_MAX_OUTPUT_BYTES=65536

# =============================================================================
# HolmesGPT 运维引擎（Nexora 只 HTTP 转发，不 import holmes 源码）
# 本地旁路：本机起 Holmes 后填 127.0.0.1:5050
# Compose：填 http://holmes:5050（compose 会覆盖 api 环境变量）
# =============================================================================
HOLMES_ENABLED=false
HOLMES_API_BASE=http://127.0.0.1:5050
HOLMES_API_KEY=
HOLMES_DEFAULT_MODEL=openai/deepseek-chat
HOLMES_TIMEOUT_SEC=300
# Compose 拉官方镜像时用；自建可改 nexora-holmes:latest
HOLMES_IMAGE=robustadev/holmes:latest

# =============================================================================
# Ops 交互终端（ttyd；需 SANDBOX_ENABLED=true）
# =============================================================================
OPS_TTYD_ENABLED=false
# native=本机跑 ttyd；wsl=Windows 开发机推荐（能正常打字）
OPS_TTYD_RUNTIME=native
# wsl 时填发行版名（wsl -l -v），空=默认
OPS_TTYD_WSL_DISTRO=
OPS_TTYD_WSL_EXE=wsl
# native：PATH 里的 ttyd，或 Windows 下 tools/ttyd.exe
# wsl：填 Linux 路径，比如 /usr/bin/ttyd（在 WSL 里 which ttyd）
OPS_TTYD_BIN=ttyd
# OPS_TTYD_BIN=D:\LangChain_Demo\tools\ttyd.exe
# OPS_TTYD_BIN=/usr/bin/ttyd
OPS_TTYD_BIND=127.0.0.1
OPS_TTYD_PORT_MIN=9100
OPS_TTYD_PORT_MAX=9199
OPS_TTYD_TICKET_TTL_SEC=600
OPS_TTYD_SHELL=/bin/bash
OPS_TTYD_MAX_PER_USER=1
OPS_TTYD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OPS_TTYD_DENY_USERS=
# Windows/WSL 先建议 false，输入稳了再开录制
OPS_TTYD_RECORDING_ENABLED=false

# Electron 桌面（可选）
# LANGCHAIN_API_BASE=http://127.0.0.1:8020
# LANGCHAIN_API_HOST=127.0.0.1
# LANGCHAIN_API_PORT=8020
OPS_CREDENTIALS_KEY=
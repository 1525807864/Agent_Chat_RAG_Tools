# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# System environment variables take precedence over this file when already set.

# DeepSeek (required for LLM calls if UI does not send api_key)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Session memory: sqlite (local) | redis
MEMORY_BACKEND=sqlite
# 四子系统记忆 / Solip（chat 模式）
# MEMDIR_PATH=data/memdir
# MEMORY_SOLIP_ENABLED=true
# MEMORY_SOLIP_TOP_K=3
# MEMORY_RELEVANCE_TOP_K=6
# Tavily search — put the real key only in local `.env` (gitignored). Leave empty here.
TAVILY_API_KEY=
# Cursor Agent SDK（https://cursor.com/dashboard/integrations）。真实密钥只放 .env。
# 值以 crsr_ 开头，不要写成 cursor:crsr_...
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
#SEARCH_RESULT_LIMIT=5
#SEARCH_TIMEOUT=10
# 若出现 SSL EOF / 证书错误，可改为 false（仅开发环境）
# SEARCH_SSL_VERIFY=false
# Optional
# REDIS_URL=redis://localhost:6379/0
# DEBUG=false
# LOG_LEVEL=INFO

# Electron desktop (optional overrides for local FastAPI URL)
# LANGCHAIN_API_BASE=http://127.0.0.1:8020
# LANGCHAIN_API_HOST=127.0.0.1
# LANGCHAIN_API_PORT=8020

# AUTH（本地 Electron 建议 false；联调鉴权时改为 true）
AUTH_ENABLED=false
JWT_SECRET=change-me-to-long-random-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENABLE_EXECUTE_PYTHON=false
RATE_LIMIT_BACKEND=memory
STRICT_PRODUCTION=false
# 生产默认 mysql；本地没有 MySQL 时改为 sqlite
AUTH_BACKEND=mysql
AUTH_USERS_DB_PATH=data/users.db
ALLOW_REGISTER=true

# 桌面安装包：把 npm run dist 产出的 exe 复制为 downloads/Nexora-Setup.exe
DESKTOP_DOWNLOAD_ENABLED=true
DESKTOP_RELEASE_DIR=downloads
DESKTOP_RELEASE_NAME=Nexora-Setup.exe

# MySQL（AUTH_BACKEND=mysql 时必填；Compose 内 MYSQL_HOST 必须是 mysql）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=langchain_demo
MYSQL_PASSWORD=
MYSQL_DATABASE=langchain_demo
MYSQL_ROOT_PASSWORD=

DEFAULT_TENANT_ID=default
OTEL_ENABLED=false

# 空库时引导管理员（密码入库后为 Argon2，不再每次明文比对）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# 生产务必：AUTH_ENABLED=true、STRICT_PRODUCTION=true、换 JWT_SECRET
# AUTH_DEBUG_ENABLED=false、OPENAPI_ENABLED=false、RATE_LIMIT_BACKEND=redis
# AUTH_DEBUG_ENABLED=true
# OPENAPI_ENABLED=true
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
# Embedding：须与 Key 同一厂商。智谱示例如下；OpenAI 则改 api.openai.com + text-embedding-3-small
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
# E2E：生产务必 false；本机测自己的 5173 才 true
E2E_ALLOW_LOCAL=false
E2E_TIMEOUT_SECONDS=120
E2E_USER=
E2E_PASSWORD=
# Playwright MCP（官方浏览器工具，Agent 点点点）
E2E_MCP_COMMAND=npx
E2E_MCP_ARGS=-y,@playwright/mcp@latest,--headless
# 通用 MCP（JSON 数组）。空 = agent 模式不拉外部 MCP；E2E 仍走专用 Playwright 通路
# MCP_SERVERS_JSON=[{"name":"playwright","transport":"stdio","command":"npx","args":["-y","@playwright/mcp@latest","--headless"]}]
MCP_SERVERS_JSON=
# 主动工具发现：工具变多后再开 true
ACTIVE_TOOL_DISCOVERY=false
ACTIVE_TOOL_TOP_K=5
ACTIVE_TOOL_BASE=calculator,web_search
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_FETCH_K=10
HYBRID_RRF_K=60
HYBRID_USE_ROUTER=true

# LangSmith（对话链路追踪）。密钥只放本机 .env，不要提交。
# 这不是 Electron 的 LANGCHAIN_API_BASE（那个是本机 FastAPI 地址）。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexora-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
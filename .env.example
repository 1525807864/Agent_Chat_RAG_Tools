# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# System environment variables take precedence over this file when already set.

# DeepSeek (required for LLM calls if UI does not send api_key)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Session memory: sqlite (local) | redis
MEMORY_BACKEND=sqlite
# 四子系统记忆 / Solip（chat 模式）
# MEMDIR_PATH=data/memdir
# MEMORY_SOLIP_ENABLED=true
# MEMORY_SOLIP_TOP_K=3
# MEMORY_RELEVANCE_TOP_K=6
# Tavily search — put the real key only in local `.env` (gitignored). Leave empty here.
TAVILY_API_KEY=
#SEARCH_RESULT_LIMIT=5
#SEARCH_TIMEOUT=10
# 若出现 SSL EOF / 证书错误，可改为 false（仅开发环境）
# SEARCH_SSL_VERIFY=false
# Optional
# REDIS_URL=redis://localhost:6379/0
# DEBUG=false
# LOG_LEVEL=INFO

# Electron desktop (optional overrides for local FastAPI URL)
# LANGCHAIN_API_BASE=http://127.0.0.1:8020
# LANGCHAIN_API_HOST=127.0.0.1
# LANGCHAIN_API_PORT=8020

# AUTH（本地 Electron 建议 false；联调鉴权时改为 true）
AUTH_ENABLED=false
JWT_SECRET=change-me-to-long-random-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENABLE_EXECUTE_PYTHON=false
RATE_LIMIT_BACKEND=memory
STRICT_PRODUCTION=false
AUTH_USERS_DB_PATH=data/users.db
ALLOW_REGISTER=false

DEFAULT_TENANT_ID=default
OTEL_ENABLED=false

# 空库时引导管理员（密码入库后为 Argon2，不再每次明文比对）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# 生产务必：AUTH_ENABLED=true、STRICT_PRODUCTION=true、换 JWT_SECRET
# AUTH_DEBUG_ENABLED=false、OPENAPI_ENABLED=false、RATE_LIMIT_BACKEND=redis
# AUTH_DEBUG_ENABLED=true
# OPENAPI_ENABLED=true
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

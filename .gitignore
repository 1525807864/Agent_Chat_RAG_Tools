# --- secrets / local env (never commit) ---
# Real keys (DeepSeek / Tavily / JWT / Embedding) live only in .env — not here.
.env
.env.*
!.env.example
!**/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
**/credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.envrc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# --- IDE / OS / local Claude ---
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db

# --- runtime data (local DBs, vectors, logs, session memory) ---
*.db
*.db-*
data/**/*.db
data/**/*.db-*
data/app.log
data/vector_store/
data/knowledge_graph.json
data/workspace/
data/memdir/
data/tenants/

# --- frontend / Electron ---
frontend/node_modules/
frontend/dist/
frontend/release/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/node_modules/.tmp/

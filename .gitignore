# --- secrets / local env (never commit) ---
# Real keys (DeepSeek / Tavily / JWT / Embedding) live only in .env — not here.
.env
.env.*
!.env.example
!**/.env.example
!.env.production.example
# 本机 K8s 精简 Secret（含真实密钥）；模板 env.k8s.example 可提交
deploy/k8s/env.k8s
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
**/credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
# 只忽略仓库根目录的 dist/build，不要误伤 frontend 源码目录
/dist/
/build/
.venv/
venv/
.envrc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# --- IDE / OS / local Claude ---
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db

# --- frontend：源码要提交；只忽略依赖与本地构建产物 ---
frontend/node_modules/
frontend/dist/
frontend/release/
downloads/*.exe
frontend/.vite/

# --- runtime data (local DBs, vectors, logs, session memory) ---
*.db
*.db-*
data/**/*.db
data/**/*.db-*
data/app.log
data/vector_store/
data/knowledge_graph.json
data/workspace/
data/memdir/
data/tenants/

# QA tenant projects / cases / runs (local runtime)
data/qa/

# Ops 终端审计、沙箱会话本地数据
data/ops/
data/sandbox/

# 本机 ttyd 二进制与临时诊断脚本（勿提交）
tools/ttyd.exe
tools/ttyd
tools/_diag_*.py
tools/_last_*.txt

# semantic memory jsonl (local session artifacts)
data/memory_semantic/

# local Playwright install under data/e2e (if present)
data/e2e/node_modules/

# --- local automation / debug artifacts (never commit) ---
.playwright-mcp/
/baidu-*.png
/draggable-*.png

# 评测跑批报告与本地缓存（保留目录占位）
evals/reports/*
!evals/reports/.gitkeep
evals/.deepeval
evals/.pytest_cache/

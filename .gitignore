# --- secrets / local env (never commit) ---
# Real keys (DeepSeek / Tavily / JWT / Embedding) live only in .env — not here.
.env
.env.*
!.env.example
!**/.env.example
!.env.production.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
**/credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
# 只忽略仓库根目录的 dist/build，不要误伤 frontend 源码目录
/dist/
/build/
.venv/
venv/
.envrc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# --- IDE / OS / local Claude ---
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db

# --- frontend：源码要提交；只忽略依赖与本地构建产物 ---
frontend/node_modules/
frontend/dist/
frontend/release/
downloads/*.exe
frontend/.vite/

# --- runtime data (local DBs, vectors, logs, session memory) ---
*.db
*.db-*
data/**/*.db
data/**/*.db-*
data/app.log
data/vector_store/
data/knowledge_graph.json
data/workspace/
data/memdir/
data/tenants/

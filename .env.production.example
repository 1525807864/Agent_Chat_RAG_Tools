# =============================================================================
# 生产机 `.env` 模板（阿里云 + docker compose）
# 复制为服务器上的 `/opt/LangChain_Demo/.env`，切勿提交真实文件。
# compose 会覆盖部分项（REDIS_URL / MYSQL_HOST / HOLMES_API_BASE 等）。
# =============================================================================

# --- LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
TAVILY_API_KEY=
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
SEARCH_SSL_VERIFY=true
ENABLE_EXECUTE_PYTHON=false

# Embedding（与本地一致即可）
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3

# --- 会话：生产必须 redis（compose 内服务名 redis）---
MEMORY_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# --- 鉴权（必须） ---
AUTH_ENABLED=true
STRICT_PRODUCTION=true
AUTH_DEBUG_ENABLED=false
OPENAPI_ENABLED=false
JWT_SECRET=replace-with-openssl-rand-hex-32-or-longer-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
DEFAULT_TENANT_ID=default
AUTH_USERS_DB_PATH=data/users.db
AUTH_BOOTSTRAP_RESET_ADMIN=false
ALLOW_REGISTER=true
AUTH_BACKEND=mysql

# 仅空库首次启动创建管理员；之后改密码请改库
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- MySQL（compose 会把 MYSQL_HOST 覆写为 mysql）---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=langchain_demo
MYSQL_PASSWORD=
MYSQL_DATABASE=langchain_demo
MYSQL_ROOT_PASSWORD=

# --- 限流 ---
RATE_LIMIT_BACKEND=redis
LOGIN_RATE_LIMIT=5
RATE_LIMIT_REQUESTS=60
TRUST_PROXY=true

# --- HTTP ---
CORS_ORIGINS=https://www.lspagent.online,https://lspagent.online
ALLOWED_HOSTS=www.lspagent.online,lspagent.online
DEBUG=false
LOG_LEVEL=INFO

# --- 桌面安装包（挂载到容器 /app/downloads）---
DESKTOP_DOWNLOAD_ENABLED=true
DESKTOP_RELEASE_DIR=/app/downloads
DESKTOP_RELEASE_NAME=Nexora-Setup.exe

# --- RAG ---
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_FETCH_K=10
HYBRID_RRF_K=60
HYBRID_USE_ROUTER=true

# E2E：生产务必关闭
E2E_ALLOW_LOCAL=false

# LangSmith（可选；密钥只放服务器）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexora-prod

# =============================================================================
# HolmesGPT sidecar（docker-compose 服务名 holmes）
# =============================================================================
HOLMES_ENABLED=true
# ★ Compose 内网地址；不要写 127.0.0.1
HOLMES_API_BASE=http://holmes:5050
HOLMES_API_KEY=
HOLMES_DEFAULT_MODEL=openai/deepseek-flash
HOLMES_TIMEOUT_SEC=300
HOLMES_IMAGE=robustadev/holmes:latest

# =============================================================================
# 平台沙箱（api 经 docker.sock 起短生命周期容器）
# 先：docker compose --profile build build sandbox-image
# =============================================================================
SANDBOX_ENABLED=true
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=nexora-sandbox:latest
# ★ 必须是宿主机绝对路径，且与 compose volume 一致
SANDBOX_WORKSPACE_HOST=/opt/LangChain_Demo/data/sandbox
SANDBOX_MODE=workspace-write
SANDBOX_NETWORK=none
SANDBOX_NETWORK_MODE=deny
SANDBOX_EGRESS_ALLOWLIST=
SANDBOX_EGRESS_PROXY_PORT=18080
SANDBOX_APPROVAL=on-risky
SANDBOX_MAX_SESSIONS_PER_TENANT=3
SANDBOX_ALLOW_SHELL_STRING=false
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_IDLE_SEC=1800
SANDBOX_EXEC_TIMEOUT_SEC=60
SANDBOX_MAX_OUTPUT_BYTES=65536

# =============================================================================
# Ops 交互终端（ttyd；API 镜像需含 ttyd + docker-ce-cli）
# =============================================================================
OPS_TTYD_ENABLED=true
OPS_TTYD_BIN=ttyd
OPS_TTYD_BIND=127.0.0.1
OPS_TTYD_PORT_MIN=9100
OPS_TTYD_PORT_MAX=9199
OPS_TTYD_TICKET_TTL_SEC=600
OPS_TTYD_SHELL=/bin/bash
OPS_TTYD_MAX_PER_USER=1
# 生产写你的前端域名（HTTPS）
OPS_TTYD_ALLOWED_ORIGINS=https://www.lspagent.online,https://lspagent.online
OPS_TTYD_DENY_USERS=
OPS_TTYD_RECORDING_ENABLED=true
OPS_CREDENTIALS_KEY=
# =============================================================================
# 本机 / 集群 Secret 精简模板（nexora-secret）
# 复制为 env.k8s 后填真实值，再：
#   kubectl -n nexora create secret generic nexora-secret --from-env-file=deploy/k8s/env.k8s
# 规则：KEY=value，等号两边无空格；每个键只出现一次；勿提交 env.k8s。
# =============================================================================

# --- MySQL（mysql Deployment 用 ROOT；api 用 USER/PASSWORD）---
# 若 MYSQL_USER=root，则 MYSQL_PASSWORD 必须与 MYSQL_ROOT_PASSWORD 相同；
# 且 20-mysql.yaml 不得再设置 MYSQL_USER（官方镜像会拒绝 root 作为 MYSQL_USER）。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=langchain_demo
MYSQL_USER=root
MYSQL_PASSWORD=

# --- API 鉴权 / LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Embedding（Memory V2 / 混合召回；缺了会静默降级为关键词）---
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# --- Ops 多客户凭证加密（可选；不配则 API 用 JWT_SECRET 派生）---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OPS_CREDENTIALS_KEY=

# --- 可选（有值再取消注释，并在 40-api.yaml 增加对应 secretKeyRef）---
# TAVILY_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexora-k8s
# LANGSMITH_TRACING=true
# HOLMES_API_KEY=
